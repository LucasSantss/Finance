# ─── Banco de dados — Neon PostgreSQL ──────────────────────────────────────
# Obtenha em: https://console.neon.tech → seu projeto → Connection Details
# Use a URL "pooled" para DATABASE_URL e a "direct" para DIRECT_URL (migrações)

DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── NextAuth ───────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET="seu-secret-aqui-minimo-32-chars"

# URL base da aplicação
AUTH_URL="http://localhost:3000"   # Em produção: https://seudominio.vercel.app

# ─── Providers OAuth ────────────────────────────────────────────────────────
# Google → https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub → https://github.com/settings/developers
GITHUB_ID=""
GITHUB_SECRET=""

# ─── Webhook — Open Finance ─────────────────────────────────────────────────
# Gere um secret forte: openssl rand -hex 32
# Use este valor no header x-webhook-secret das suas requisições externas
WEBHOOK_SECRET="seu-webhook-secret-forte-aqui"

# ─── Vercel (preenchido automaticamente em produção) ────────────────────────
# VERCEL_URL=  # Não precisa definir, a Vercel injeta automaticamente
